{
  "version": 1,
  "routes": [
    {
      "id": "next-api",
      "framework": "next",
      "surface": "api",
      "routePattern": "/docs/api/{...slug}",
      "routeFiles": [
        "docsfn/examples/next-docs-site/app/docs/[[...slug]]/page.tsx"
      ],
      "requiredMarkers": [
        "routeEntry.kind === \"api\"",
        "ApiReferenceRenderer"
      ]
    },
    {
      "id": "next-blog",
      "framework": "next",
      "surface": "blog",
      "routePattern": "/blog/{slug}",
      "routeFiles": [
        "docsfn/examples/next-docs-site/app/blog/[...slug]/page.tsx"
      ],
      "requiredMarkers": [
        "data-docsfn-blog-post",
        "DocsContent"
      ]
    },
    {
      "id": "next-docs",
      "framework": "next",
      "surface": "docs",
      "routePattern": "/docs/{...slug}",
      "routeFiles": [
        "docsfn/examples/next-docs-site/app/docs/[[...slug]]/page.tsx"
      ],
      "requiredMarkers": [
        "resolveDocsRouteData",
        "DocsContent",
        "data-docsfn-search-runtime"
      ]
    },
    {
      "id": "next-embedded",
      "framework": "next",
      "surface": "embedded",
      "routePattern": "/embedded/{...slug}",
      "routeFiles": [
        "docsfn/examples/next-docs-site/app/embedded/[[...slug]]/page.tsx"
      ],
      "requiredMarkers": [
        "data-docsfn-proof-surface=\"embedded\"",
        "ReactEmbeddedPage"
      ]
    },
    {
      "id": "sveltekit-api",
      "framework": "sveltekit",
      "surface": "api",
      "routePattern": "/docs/api/{...slug}",
      "routeFiles": [
        "docsfn/examples/sveltekit-docs-site/src/routes/docs/[...slug]/+page.server.ts",
        "docsfn/examples/sveltekit-docs-site/src/routes/docs/[...slug]/+page.svelte"
      ],
      "requiredMarkers": [
        "resolveDocsRouteDataOrThrow",
        "ApiReferenceRenderer"
      ]
    },
    {
      "id": "sveltekit-blog",
      "framework": "sveltekit",
      "surface": "blog",
      "routePattern": "/blog/{slug}",
      "routeFiles": [
        "docsfn/examples/sveltekit-docs-site/src/routes/blog/[...slug]/+page.server.ts",
        "docsfn/examples/sveltekit-docs-site/src/routes/blog/[...slug]/+page.svelte"
      ],
      "requiredMarkers": [
        "data-docsfn-blog-post",
        "DocsContent"
      ]
    },
    {
      "id": "sveltekit-docs",
      "framework": "sveltekit",
      "surface": "docs",
      "routePattern": "/docs/{...slug}",
      "routeFiles": [
        "docsfn/examples/sveltekit-docs-site/src/routes/docs/[...slug]/+page.server.ts",
        "docsfn/examples/sveltekit-docs-site/src/routes/docs/[...slug]/+page.svelte"
      ],
      "requiredMarkers": [
        "resolveDocsRouteDataOrThrow",
        "DocsContent",
        "data-docsfn-search-runtime"
      ]
    },
    {
      "id": "sveltekit-embedded",
      "framework": "sveltekit",
      "surface": "embedded",
      "routePattern": "/embedded/{...slug}",
      "routeFiles": [
        "docsfn/examples/sveltekit-docs-site/src/routes/embedded/[...slug]/+page.server.ts",
        "docsfn/examples/sveltekit-docs-site/src/routes/embedded/[...slug]/+page.svelte"
      ],
      "requiredMarkers": [
        "data-docsfn-proof-surface=\"embedded\"",
        "EmbeddedPage"
      ]
    }
  ]
}
