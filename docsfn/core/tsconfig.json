{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@searchfn/client": ["../../searchfn/client/src/index.ts"],
      "@searchfn/core": ["../../searchfn/core/src/index.ts"],
      "@searchfn/adapter-contracts": ["../../searchfn/adapter-contracts/src/index.ts"],
      "@searchfn/adapter-memory": ["../../searchfn/adapter-memory/src/index.ts"],
      "@searchfn/adapter-indexeddb": ["../../searchfn/adapter-indexeddb/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
