{
  "name": "@docsfn/sveltekit",
  "version": "0.0.3",
  "description": "SvelteKit 2 adapter for docsfn",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "node -e \"console.log('No tests configured')\""
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "svelte": ">=5.20.0 <6"
  },
  "dependencies": {
    "@docsfn/core": "0.0.6"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "author": "21n",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/21nCo/super-functions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "docsfn/sveltekit"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ]
}
