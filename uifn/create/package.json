{
  "name": "@uifn/create",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Schema-driven visual editor for versioned uifn presets",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vite": "^5.4.21",
    "vitest": "^3.2.4"
  },
  "uifn": {
    "status": "tooling",
    "layer": "create",
    "sourcePolicy": "clean-room"
  },
  "dependencies": {
    "@uifn/components-react": "0.0.1",
    "@uifn/components": "0.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
