e primary API contract. Add `routing?: AuthFnCanonicalRoutingConfig` to this interface.</comment>\\n\\n<file context>\\n@@ -5913,14 +5932,18 @@ authFnMultiRegionPlugin({\\n-  lookupStore?: AuthFnRegionLookupStore;\\n-  directory?: AuthFnMultiRegionDirectory;          // deprecated, use lookupStore\\n+  lookupStore?: ConditionalKVStoreAdapter;\\n+  observability?: ObservabilityInput<AuthFnEvent>;\\n }\\n \\n</file context>\\n```\\n\\n</details>\\n\\n```suggestion\\n  observability?: ObservabilityInput<AuthFnEvent>;\\n  routing?: AuthFnCanonicalRoutingConfig;\\n```\\n\\n✅ Addressed in [`be0dde5`](https://github.com/21nCo/super-functions/commit/be0dde5d0b2fc65c877f304ff68feb0e0717013a)\",\"created_at\":\"2026-08-24T03:20:13Z\",\"updated_at\":\"2026-08-24T04:07:37Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/120#discussion_r3840490386\",\"pull_request_url\":\"https://api.github.com/repos/21nCo/super-functions/pulls/120\",\"_links\":{\"self\":{\"href\":\"https://api.github.com/repos/21nCo/super-functions/pulls/comments/3840490386\"},\"html\":{\"href\":\"https://github.com/21nCo/super-functions/pull/120#discussion_r3840490386\"},\"pull_request\":{\"href\":\"https://api.github.com/repos/21nCo/super-functions/pulls/120\"}},\"reactions\":{\"url\":\"https://api.github.com/repos/21nCo/super-functions/pulls/comments/3840490386/reactions\",\"total_count\":0,\"+1\":0,\"-1\":0,\"laugh\":0,\"hooray\":0,\"confused\":0,\"heart\":0,\"rocket\":0,\"eyes\":0},\"start_line\":null,\"original_start_line\":null,\"start_side\":null,\"line\":5974,\"original_line\":5946,\"side\":\"RIGHT\",\"author_association\":\"NONE\",\"original_position\":90,\"position\":203,\"subject_type\":\"line\"},{\"url\":\"https://api.github.com/repos/21nCo/super-functions/pulls/comments/3840490395\",\"pull_request_review_id\":5004310442,\"id\":3840490395,\"node_id\":\"PRRC_kwDOP-e7KM7k6Tub\",\"diff_hunk\":\"@@ -1,10 +1,63 @@\\n import { describe, expect, it } from 'vitest';\\n import {\\n   AuthFnDynamoDbLookupStoreError,\\n+  createDynamoDbIdentityPlacementDirectory,\\n   createDynamoDbRegionLookupStore\\n } from '../index.js';\\n \\n describe('@authfn/lookup-dynamodb', () => {\\n+  it('provides atomic identity-placement claims and epoch moves', async () => {\\n+    let item: Record<string, unknown> | undefined;\\n+    const directory = createDynamoDbIdentityPlacementDirectory({\\n+      tableName: 'authfn-placement',\\n+      consistencyModel: 'single-writer-strong',\\n+      ttlAttributeName: false,\\n+      documentClient: {\\n+        async send(command: any) {\",\"path\":\"authfn/adapters/lookup-dynamodb/src/__tests__/lookup-dynamodb.test.ts\",\"commit_id\":\"bf3a19d192741f0ef19c676cb37e7713a1794aaa\",\"original_commit_id\":\"e763ea93692403c4a405616b3f239e8e094b5c44\",\"user\":{\"login\":\"cubic-dev-ai[bot]\",\"id\":191113872,\"node_id\":\"BOT_kgDOC2QqkA\",\"avatar_url\":\"https://avatars.githubusercontent.com/in/1082092?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D\",\"html_url\":\"https://github.com/apps/cubic-dev-ai\",\"followers_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/followers\",\"following_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/subscriptions\",\"organizations_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/orgs\",\"repos_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/repos\",\"events_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/received_events\",\"type\":\"Bot\",\"user_view_type\":\"public\",\"site_admin\":false},\"body\":\"<!-- cubic:v=e255fe2b-72d4-486c-94c7-6d9c6a959a40 -->\\n<!-- cubic:review-run=1ce485a1-dead-4477-95a7-9a5fa8ddb259 -->\\n<!-- metadata:{\\\"confidence\\\":7} -->\\nP3: This test never verifies the DynamoDB requests the adapter sends: the mock only echoes writes (`item = input.Item`), its conditional-failure branches can never trigger in this flow, and no assertion inspects the commands (unlike every other test in this file, which asserts on a `sent` array). A regression that drops the PutItem `ConditionExpression` or `ConsistentRead: true` on GetItem would still pass this test, so the \\\"atomic claims\\\" behavior named in the test title is not actually validated. Capture the sent commands and assert `ConditionExpression` / `ExpressionAttributeValues` on the writes and `ConsistentRead: true` on the read.\\n\\n<details>\\n<summary>Prompt for AI agents</summary>\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At authfn/adapters/lookup-dynamodb/src/__tests__/lookup-dynamodb.test.ts, line 16:\\n\\n<comment>This test never verifies the DynamoDB requests the adapter sends: the mock only echoes writes (`item = input.Item`), its conditional-failure branches can never trigger in this flow, and no assertion inspects the commands (unlike every other test in this file, which asserts on a `sent` array). A regression that drops the PutItem `ConditionExpression` or `ConsistentRead: true` on GetItem would still pass this test, so the \\\"atomic claims\\\" behavior named in the test title is not actually validated. Capture the sent commands and assert `ConditionExpression` / `ExpressionAttributeValues` on the writes and `ConsistentRead: true` on the read.</comment>\\n\\n<file context>\\n@@ -1,10 +1,63 @@\\n+      consistencyModel: 'single-writer-strong',\\n+      ttlAttributeName: false,\\n+      documentClient: {\\n+        async send(command: any) {\\n+          const input = command.input as Record<string, any>;\\n+          if (input.Key) return { Item: item };\\n</file context>\\n```\\n\\n</details>\\n\\n✅ Addressed in [`2bd60a1`](https://github.com/21nCo/super-functions/commit/2bd60a175d397267c276498dbb834c8f52bfc497)\",\"created_at\":\"2026-08-24T03:20:13Z\",\"updated_at\":\"2026-08-24T16:21:37Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/120#discussion_r3840490395\",\"pull_request_url\":\"https://api.github.com/repos/21nCo/super-functions/pulls/120\",\"_links\":{\"self\":{\"href\":\"https://api.github.com/repos/21nCo/super-functions/pulls/comments/3840490395\"},\"html\":{\"href\":\"https://github.com/21nCo/super-functions/pull/120#discussion_r3840490395\"},\"pull_request\":{\"href\":\"https://api.github.com/repos/21nCo/super-functions/pulls/120\"}},\"reactions\":{\"url\":\"https://api.github.com/repos/21nCo/super-functions/pulls/comments/3840490395/reactions\",\"total_count\":0,\"+1\":0,\"-1\":0,\"laugh\":0,\"hooray\":0,\"confused\":0,\"heart\":0,\"rocket\":0,\"eyes\":0},\"start_line\":null,\"original_start_line\":null,\"start_side\":null,\"line\":20,\"original_line\":16,\"side\":\"RIGHT\",\"author_association\":\"NONE\",\"original_position\":16,\"position\":21,\"subject_type\":\"line\"},{\"url\":\"https://api.github.com/repos/21nCo/super-functions/pulls/comments/3840490398\",\"pull_request_review_id\":5004310442,\"id\":3840490398,\"node_id\":\"PRRC_kwDOP-e7KM7k6Tue\",\"diff_hunk\":\"@@ -0,0 +1,559 @@\\n+import { describe, expect, it } from 'vitest';\\n+import { createRouter, type Router } from '@superfunctions/http';\\n+import type { ConditionalKVStoreAdapter } from '@superfunctions/db';\\n+import {\\n+  classifyAuthFnRoute,\\n+  createAuthFnCanonicalGateway,\\n+  createAuthFnCellPlacementMiddleware,\\n+  createInMemoryAuthFnPlacementDirectory,\\n+  createInMemoryAuthFnRoutingReplayStore,\\n+  createStoreBackedAuthFnPlacementDirectory,\\n+  moveAuthFnIdentityPlacement\\n+} from '../core/gateway-routing.js';\\n+import type {\\n+  AuthFnIdentityPlacement,\\n+  AuthFnRoutingKeyring,\\n+  MultiRegionPluginRuntimeConfig\\n+} from '../plugin-types.js';\\n+import { authFnMultiRegionEnvironment } from '../core/regions.js';\\n+\\n+const keyring: AuthFnRoutingKeyring = {\\n+  active: {\\n+    keyId: 'routing-2026-08',\\n+    secret: 'test-routing-secret-with-enough-entropy'\\n+  }\\n+};\\n+\\n+describe('AuthFn canonical gateway routing', () => {\\n+  it('claims placement only for explicitly approved first-use routes', async () => {\\n+    const directory = createInMemoryAuthFnPlacementDirectory();\\n+    const effects: string[] = [];\\n+    const cell = createCell('us-east-1', directory, effects);\\n+    let allowInitialPlacement = false;\\n+    let dispatches = 0;\\n+    const gateway = createAuthFnCanonicalGateway<Router>({\\n+      publicAuthority: 'https://account.example.com',\\n+      placementDirectory: directory,\\n+      keyring,\",\"path\":\"authfn/core/src/__tests__/gateway-routing.test.ts\",\"commit_id\":\"bf3a19d192741f0ef19c676cb37e7713a1794aaa\",\"original_commit_id\":\"e763ea93692403c4a405616b3f239e8e094b5c44\",\"user\":{\"login\":\"cubic-dev-ai[bot]\",\"id\":191113872,\"node_id\":\"BOT_kgDOC2QqkA\",\"avatar_url\":\"https://avatars.githubusercontent.com/in/1082092?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D\",\"html_url\":\"https://github.com/apps/cubic-dev-ai\",\"followers_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/followers\",\"following_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/subscriptions\",\"organizations_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/orgs\",\"repos_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/repos\",\"events_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/received_events\",\"type\":\"Bot\",\"user_view_type\":\"public\",\"site_admin\":false},\"body\":\"<!-- cubic:v=6d686f54-9555-4f71-b49b-c091dcec7458 -->\\n<!-- cubic:review-run=1ce485a1-dead-4477-95a7-9a5fa8ddb259 -->\\n<!-- metadata:{\\\"confidence\\\":6} -->\\nP3: The stale-cell dispatch (and therefore `expect(calls).toEqual(['us-east-1','us-east-1','eu-west-1'])` and the assertion `x-authfn-routing-mismatch` is null after retry) depends on the default 5s `placementCacheTtlMs` still holding the pre-move placement. If the test takes longer than 5s, the second handle routes directly to eu-west-1 and the mismatch-retry path silently stops being exercised. Pin `placementCacheTtlMs` to a large value so the retry is deterministic.\\n\\n<details>\\n<summary>Prompt for AI agents</summary>\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At authfn/core/src/__tests__/gateway-routing.test.ts, line 37:\\n\\n<comment>The stale-cell dispatch (and therefore `expect(calls).toEqual(['us-east-1','us-east-1','eu-west-1'])` and the assertion `x-authfn-routing-mismatch` is null after retry) depends on the default 5s `placementCacheTtlMs` still holding the pre-move placement. If the test takes longer than 5s, the second handle routes directly to eu-west-1 and the mismatch-retry path silently stops being exercised. Pin `placementCacheTtlMs` to a large value so the retry is deterministic.</comment>\\n\\n<file context>\\n@@ -0,0 +1,559 @@\\n+    const gateway = createAuthFnCanonicalGateway<Router>({\\n+      publicAuthority: 'https://account.example.com',\\n+      placementDirectory: directory,\\n+      keyring,\\n+      resolveIdentity: () => ({ identityKey: 'person:new', allowInitialPlacement }),\\n+      selectInitialRegion: () => 'us-east-1',\\n</file context>\\n```\\n\\n</details>\\n\\n✅ Addressed in [`be0dde5`](https://github.com/21nCo/super-functio