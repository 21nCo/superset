=> {\\n+    let item: Record<string, unknown> | undefined;\\n+    const directory = createDynamoDbIdentityPlacementDirectory({\\n+      tableName: 'authfn-placement',\\n+      consistencyModel: 'single-writer-strong',\\n+      ttlAttributeName: false,\\n+      documentClient: {\\n+        async send(command: any) {\",\"path\":\"authfn/adapters/lookup-dynamodb/src/__tests__/lookup-dynamodb.test.ts\",\"commit_id\":\"bf3a19d192741f0ef19c676cb37e7713a1794aaa\",\"original_commit_id\":\"e763ea93692403c4a405616b3f239e8e094b5c44\",\"user\":{\"login\":\"cubic-dev-ai[bot]\",\"id\":191113872,\"node_id\":\"BOT_kgDOC2QqkA\",\"avatar_url\":\"https://avatars.githubusercontent.com/in/1082092?v=4\",\"gravatar_id\":\"\",\"url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D\",\"html_url\":\"https://github.com/apps/cubic-dev-ai\",\"followers_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/followers\",\"following_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/following{/other_user}\",\"gists_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/gists{/gist_id}\",\"starred_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/starred{/owner}{/repo}\",\"subscriptions_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/subscriptions\",\"organizations_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/orgs\",\"repos_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/repos\",\"events_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/events{/privacy}\",\"received_events_url\":\"https://api.github.com/users/cubic-dev-ai%5Bbot%5D/received_events\",\"type\":\"Bot\",\"user_view_type\":\"public\",\"site_admin\":false},\"body\":\"<!-- cubic:v=e255fe2b-72d4-486c-94c7-6d9c6a959a40 -->\\n<!-- cubic:review-run=1ce485a1-dead-4477-95a7-9a5fa8ddb259 -->\\n<!-- metadata:{\\\"confidence\\\":7} -->\\nP3: This test never verifies the DynamoDB requests the adapter sends: the mock only echoes writes (`item = input.Item`), its conditional-failure branches can never trigger in this flow, and no assertion inspects the commands (unlike every other test in this file, which asserts on a `sent` array). A regression that drops the PutItem `ConditionExpression` or `ConsistentRead: true` on GetItem would still pass this test, so the \\\"atomic claims\\\" behavior named in the test title is not actually validated. Capture the sent commands and assert `ConditionExpression` / `ExpressionAttributeValues` on the writes and `ConsistentRead: true` on the read.\\n\\n<details>\\n<summary>Prompt for AI agents</summary>\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At authfn/adapters/lookup-dynamodb/src/__tests__/lookup-dynamodb.test.ts, line 16:\\n\\n<comment>This test never verifies the DynamoDB requests the adapter sends: the mock only echoes writes (`item = input.Item`), its conditional-failure branches can never trigger in this flow, and no assertion inspects the commands (unlike every other test in this file, which asserts on a `sent` array). A regression that drops the PutItem `ConditionExpression` or `ConsistentRead: true` on GetItem would still pass this test, so the \\\"atomic claims\\\" behavior named in the test title is not actually validated. Capture the sent commands and assert `ConditionExpression` / `ExpressionAttributeValues` on the writes and `ConsistentRead: true` on the read.</comment>\\n\\n<file context>\\n@@ -1,10 +1,63 @@\\n+      consistencyModel: 'single-writer-strong',\\n+      ttlAttributeName: false,\\n+      documentClient: {\\n+        async send(command: any) {\\n+          const input = command.input as Record<string, any>;\\n+          if (input.Key) return { Item: item };\\n</file context>\\n```\\n\\n</details>\\n\\n✅ Addressed in [`2bd60a1`](https://github.com/21nCo/super-functions/commit/2bd60a175d397267c276498dbb834c8f52bfc497)\",\"created_at\":\"2026-08-24T03:20:13Z\",\"updated_at\":\"2026-08-24T16:21:37Z\",\"html_url\":\"https://github.co