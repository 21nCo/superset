{
  "name": "@mcpfn/cli",
  "version": "0.0.6",
  "description": "McpFn manifest, compatibility, regression, and official conformance CLI",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": { "mcpfn": "./dist/bin.js" },
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "clean": "node --input-type=module -e \"import('node:fs').then(({ rmSync }) => rmSync('dist', { recursive: true, force: true }))\"",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@mcpfn/auth": "0.0.4",
    "@mcpfn/client": "0.0.4",
    "@mcpfn/core": "0.0.4",
    "@mcpfn/inspector": "0.0.3",
    "@mcpfn/testing": "0.0.5",
    "cac": "^6.7.14",
    "jiti": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": { "node": ">=18.18.0" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "mcpfn/cli"
  },
  "publishConfig": { "access": "public" },
  "sideEffects": false
}
