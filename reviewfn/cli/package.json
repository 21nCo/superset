{
  "name": "@superfunctions/reviewfn-cli",
  "version": "0.1.0",
  "description": "Portable evidence-backed pull request review CLI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": { "reviewfn": "./dist/main.js" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@superfunctions/reviewfn-context-composio": "0.1.0",
    "@superfunctions/reviewfn-core": "0.1.0",
    "@superfunctions/reviewfn-github": "0.1.0",
    "@superfunctions/reviewfn-harness-codex": "0.1.0",
    "@superfunctions/reviewfn-testing": "0.1.0"
  },
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.6.0", "vitest": "^3.2.4" },
  "engines": { "node": ">=22" },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/21nCo/super-functions.git", "directory": "reviewfn/cli" },
  "bugs": { "url": "https://github.com/21nCo/super-functions/issues" },
  "sideEffects": false,
  "publishConfig": { "access": "public" }
}
