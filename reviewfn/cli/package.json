{
  "name": "@reviewfn/cli",
  "version": "0.1.0",
  "description": "Portable evidence-backed pull request review CLI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": { "reviewfn": "./dist/bin.js" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md", "action.yml"],
  "scripts": { "build": "npm run clean && tsc -p tsconfig.json && node scripts/postbuild.mjs", "typecheck": "tsc --noEmit -p tsconfig.json", "test": "vitest run", "lint": "tsc --noEmit -p tsconfig.json", "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"" },
  "dependencies": { "@reviewfn/core": "0.1.0" },
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.6.0", "vitest": "^3.2.4" },
  "engines": { "node": ">=22" },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/21nCo/super-functions.git", "directory": "reviewfn/cli" },
  "publishConfig": { "access": "public" }
}
